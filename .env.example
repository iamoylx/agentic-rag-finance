# 复制为 .env 后按需覆盖；标注「用户级环境变量」的项本机已配好，无需写入
# 用途：演示项目配置结构。真实密钥永远不要提交进 Git。

# ---------- LLM 提供方 ----------
LLM_PROVIDER=agnes                # agnes | deepseek

# Agnes（用户级环境变量 AGNES_API_KEY 已配置，一般无需在此设置）
# AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# DeepSeek（备用；用户级环境变量 DEEPSEEK_API_KEY 已配置）
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 联网降级（Corrective RAG 兜底检索；用户级环境变量已配置）----------
# TAVILY_API_KEY=

# ---------- 存储（可选；留空则 Redis 用 fakeredis、MySQL 功能关闭）----------
# REDIS_URL=redis://127.0.0.1:6379/0
# MYSQL_URL=mysql+pymysql://user:pass@127.0.0.1:3306/rag

# ---------- 推理设备与精排（CPU 部署必看）----------
# EMBED_DEVICE=cpu
#
# 精排是 CPU 部署下单次请求的最大开销：实测 40 条候选精排 17–34s，
# 而编码 query 0.28s、BM25 0.02s、dense 0.01s。
# 关掉后单次检索降到亚秒级，代价是 Recall@5 从 0.9615 掉到 0.8846
# （MRR/nDCG 反而略升，详见 src/core/config.py 里 rerank_enabled 的注释）。
# RERANK_ENABLED=false
